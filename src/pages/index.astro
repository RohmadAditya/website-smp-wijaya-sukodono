          'Dalam gelaran tersebut, SDN Pekarungan berhasil meraih Juara 1, disusul SDN Klagen sebagai Juara 2, dan SDN Pademonegoro di posisi Juara 3.',
          'Kepala Sekolah Yennis Fitriyan, S.E., M.Pd. menegaskan bahwa kegiatan ini merupakan komitmen sekolah dalam memfasilitasi bakat olahraga generasi muda sejak usia sekolah dasar.'
        ]
      },
      {
        id: 'juara-harapan-1-concert-marching-millenial',
        title: 'Raih Juara Harapan 1 Concert Marching Millenial 2024, Tim Drumband SMP Wijaya Siap Naik Level',
        tanggal: '2024-12-16',
        kategori: 'Prestasi',
        ringkasan: 'Unit Marching Band SMP Wijaya Sukodono menorehkan prestasi membanggakan pada Kategori Divisi Lanjutan ajang Concert Marching Millenial Kabupaten Sidoarjo.',
        isi: [
          'Kerja keras latihan rutin tim drumband SMP Wijaya Sukodono membuahkan hasil manis dengan meraih Juara Harapan 1 pada kategori Divisi Lanjutan di ajang Concert Marching Millenial 2024 yang diselenggarakan Perkumpulan Pelatih Drum Band Sidoarjo (PPDBS).',
          'Capaian ini menjadi pemacu semangat bagi seluruh anggota ekstrakurikuler musik dan baris-berbaris sekolah untuk terus meningkatkan kualitas aransemen serta kekompakan koreografi di kompetisi mendatang.'
        ]
      },
      {
        id: 'pembukaan-spmb-2026-2027',
        title: 'Pengumuman Resmi: Sistem Penerimaan Murid Baru (SPMB) Tahun Ajaran 2026/2027 Dibuka',
        tanggal: '2026-02-02',
        kategori: 'Pengumuman',
        ringkasan: 'Pendaftaran calon peserta didik baru SMP Wijaya Sukodono gelombang pertama kini dapat diakses secara online maupun langsung di ruang Tata Usaha.',
        isi: [
          'SMP Wijaya Sukodono resmi membuka pendaftaran Sistem Penerimaan Murid Baru (SPMB) untuk Tahun Ajaran 2026/2027. Calon siswa lulusan SD/MI dapat mendaftar melalui formulir online maupun datang langsung bersama orang tua ke sekolah.',
          'Informasi lengkap mengenai kelengkapan berkas, jadwal gelombang, dan kontak panitia tersedia pada halaman SPMB di website resmi ini.'
        ]
      },
      {
        id: 'kegiatan-p5-kewirausahaan-literasi',
        title: 'Gelar Karya P5 & Pekan Literasi Siswa: Menumbuhkan Kreativitas dan Kemandirian Pelajar',
        tanggal: '2025-10-18',
        kategori: 'Akademik',
        ringkasan: 'Siswa kelas VII dan VIII menampilkan hasil karya proyek Kurikulum Merdeka bertema kearifan lokal dan gaya hidup berkelanjutan.',
        isi: [
          'Melalui Proyek Penguatan Profil Pelajar Pancasila (P5), peserta didik SMP Wijaya Sukodono memamerkan beragam karya kreatif, kerajinan ramah lingkungan, dan mading literasi di halaman sekolah.',
          'Kegiatan ini melatih keberanian presentasi, kerja sama tim, serta kepedulian siswa terhadap lingkungan sekitar.'
        ]
      },
      {
        id: 'pembinaan-karakter-pramuka-paskibra',
        title: 'Latihan Gabungan Pramuka & Paskibra Perkuat Disiplin serta Kepemimpinan Siswa',
        tanggal: '2025-09-12',
        kategori: 'Kegiatan',
        ringkasan: 'Ratusan siswa mengikuti pembinaan kedisiplinan, baris-berbaris, dan kepedulian sosial melalui agenda ekstrakurikuler terpadu.',
        isi: [
          'Ekstrakurikuler Pramuka dan Paskibra SMP Wijaya Sukodono menggelar latihan gabungan akhir pekan guna menanamkan sikap tanggung jawab, kekompakan, serta jiwa kepemimpinan sejak dini.'
        ]
      }
    ];

    let activeFacilityCat = 'Semua';
    let activeTeacherCat = 'Semua';
    let activeNewsCat = 'Semua';

    function formatDateID(dateStr) {
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
      const d = new Date(dateStr);
      return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
    }

    function navigateTo(viewName) {
      document.querySelectorAll('.page-view').forEach(el => el.classList.remove('active'));
      const target = document.getElementById('view-' + viewName);
      if (target) target.classList.add('active');

      document.querySelectorAll('.nav-link').forEach(btn => {
        const isMatch = btn.dataset.nav === viewName || (viewName === 'berita-detail' && btn.dataset.nav === 'berita');
        btn.classList.toggle('text-cerulean-600', isMatch);
        btn.classList.toggle('bg-wijayaCyan-50', isMatch);
        btn.classList.toggle('text-slate-700', !isMatch);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleMobileMenu(force) {
      const menu = document.getElementById('mobile-menu');
      if (typeof force === 'boolean') {
        menu.classList.toggle('hidden', !force);
      } else {
        menu.classList.toggle('hidden');
      }
    }

    function toggleReviewPanel() {
      document.getElementById('review-panel').classList.toggle('hidden');
    }

    function togglePpdbState(isActive) {
      const bar = document.getElementById('top-spmb-bar');
      const badge = document.getElementById('ppdb-status-badge');
      bar.classList.toggle('hidden', !isActive);
      if (isActive) {
        badge.textContent = 'STATUS: DIBUKA';
        badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-candiGold-400 text-ocean-950';
      } else {
        badge.textContent = 'STATUS: DITUTUP';
        badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-600 text-white';
      }
    }

    function facilityCardHTML(item) {
      return `
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-cerulean-600/40 transition flex flex-col">
          <div class="aspect-[4/3] bg-gradient-to-br from-ocean-950 to-ocean-900 p-5 flex flex-col justify-between relative overflow-hidden">
            ${item.foto ? `<img src="${item.foto}" alt="${item.nama}" class="absolute inset-0 w-full h-full object-cover transition duration-300 hover:scale-105" onerror="this.style.display=\'none\';" />
            <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/30 to-ocean-950/40"></div>` : ''}
            <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-sm text-sky-100 font-mono text-[11px] font-semibold">${item.kategori}</span>
            <div class="relative z-10 flex items-center justify-between gap-2">
              <span class="text-white font-bold text-base drop-shadow-md truncate">${item.nama}</span>
              <button onclick="openFacilityModal(${item.id})" class="px-3 py-1.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-xs font-bold transition shrink-0 shadow-md">Lihat Foto</button>
            </div>
          </div>
          <div class="p-5 flex-1">
            <h3 class="font-bold text-ocean-950 text-base">${item.nama}</h3>
            <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">${item.deskripsi}</p>
          </div>
        </div>
      `;
    }

    function openFacilityModal(id) {
      const item = facilitiesData.find(f => f.id === id);
      if (!item) return;
      document.getElementById('modal-category').textContent = item.kategori;
      document.getElementById('modal-title-overlay').textContent = item.nama;
      document.getElementById('modal-title').textContent = item.nama;
      document.getElementById('modal-desc').textContent = item.deskripsi;
      
      const modalImg = document.getElementById('modal-img');
      const modalOverlay = document.getElementById('modal-overlay-bg');
      if (item.foto) {
        modalImg.src = item.foto;
        modalImg.classList.remove('hidden');
        if (modalOverlay) modalOverlay.classList.remove('hidden');
      } else {
        modalImg.src = '';
        modalImg.classList.add('hidden');
        if (modalOverlay) modalOverlay.classList.add('hidden');
      }
      document.getElementById('facility-modal').classList.remove('hidden');
    }

    function closeFacilityModal() {
      document.getElementById('facility-modal').classList.add('hidden');
    }

    function renderFacilities() {
      document.getElementById('home-facilities-grid').innerHTML = facilitiesData.slice(0, 3).map(facilityCardHTML).join('');
      const cats = ['Semua', 'Akademik', 'Laboratorium', 'Olahraga & Ibadah'];
      document.getElementById('facility-filters').innerHTML = cats.map(cat => `
        <button onclick="activeFacilityCat='${cat}'; renderFacilities();" class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${activeFacilityCat === cat ? 'bg-ocean-950 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">${cat}</button>
      `).join('');
      const filtered = activeFacilityCat === 'Semua' ? facilitiesData : facilitiesData.filter(f => f.kategori === activeFacilityCat);
      document.getElementById('all-facilities-grid').innerHTML = filtered.map(facilityCardHTML).join('');
    }

    function renderTeachers() {
      const cats = ['Semua', 'Pimpinan', 'Guru Mapel', 'Staf TU'];
      document.getElementById('teacher-filters').innerHTML = cats.map(cat => `
        <button onclick="activeTeacherCat='${cat}'; renderTeachers();" class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${activeTeacherCat === cat ? 'bg-ocean-950 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">${cat}</button>
      `).join('');

      const q = (document.getElementById('teacher-search')?.value || '').toLowerCase();
      const filtered = teachersData.filter(t =>
        (activeTeacherCat === 'Semua' || t.bidang === activeTeacherCat) &&
        (t.nama.toLowerCase().includes(q) || t.jabatan.toLowerCase().includes(q))
      );

      document.getElementById('teachers-grid').innerHTML = filtered.length ? filtered.map(t => `
        <div class="bg-white rounded-xl border ${t.bidang === 'Pimpinan' ? 'border-cerulean-600/40 ring-1 ring-cerulean-600/10' : 'border-slate-200'} p-5 text-center hover:shadow-md transition">
          ${t.foto ? `
            <div class="w-24 h-24 mx-auto rounded-2xl overflow-hidden mb-4 border-2 border-slate-200 shadow-sm bg-slate-100 flex items-center justify-center">
              <img src="${t.foto}" alt="${t.nama}" class="w-full h-full object-cover" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-2xl font-extrabold text-cerulean-600 bg-wijayaCyan-50\'>${t.inisial || t.nama.slice(0, 2).toUpperCase()}</div>';" />
            </div>
          ` : `
            <div class="w-24 h-24 mx-auto rounded-2xl ${t.bidang === 'Pimpinan' ? 'bg-ocean-950 text-candiGold-400' : 'bg-wijayaCyan-50 text-cerulean-600'} flex items-center justify-center text-2xl font-extrabold mb-4 shadow-sm">${t.inisial || t.nama.slice(0, 2).toUpperCase()}</div>
          `}
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono text-[11px] font-semibold mb-2">${t.bidang}</span>
          <h3 class="font-bold text-ocean-950 text-base">${t.nama}</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">${t.jabatan}</p>
        </div>
      `).join('') : `<div class="col-span-full text-center py-12 text-slate-500 text-sm">Data guru atau staf tidak ditemukan.</div>`;
    }

    function newsCardHTML(item) {
      return `
        <article onclick="openNewsDetail('${item.id}')" class="cursor-pointer bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-cerulean-600/40 transition flex flex-col">
          <div class="aspect-video bg-gradient-to-br from-ocean-950 to-ocean-900 p-4 flex flex-col justify-between relative">
            <span class="self-start px-2.5 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-[11px] font-bold">${item.kategori}</span>
            <div class="flex items-center justify-between text-sky-200/80 text-xs font-mono">
              <span>${formatDateID(item.tanggal)}</span>
              <span>SMP Wijaya</span>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <h3 class="font-bold text-ocean-950 text-base leading-snug line-clamp-2">${item.title}</h3>
            <p class="text-sm text-slate-600 mt-2 line-clamp-3 flex-1">${item.ringkasan}</p>
            <div class="pt-4 text-sm font-semibold text-cerulean-600">Baca Selengkapnya &rarr;</div>
          </div>
        </article>
      `;
    }

    function renderNewsPage() {
      document.getElementById('home-news-grid').innerHTML = newsData.slice(0, 3).map(newsCardHTML).join('');
      const cats = ['Semua', 'Kegiatan', 'Prestasi', 'Pengumuman', 'Akademik'];
      document.getElementById('news-filters').innerHTML = cats.map(cat => `
        <button onclick="activeNewsCat='${cat}'; renderNewsPage();" class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition ${activeNewsCat === cat ? 'bg-ocean-950 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">${cat}</button>
      `).join('');

      const q = (document.getElementById('news-search')?.value || '').toLowerCase();
      const filtered = newsData.filter(n =>
        (activeNewsCat === 'Semua' || n.kategori === activeNewsCat) &&
        (n.title.toLowerCase().includes(q) || n.ringkasan.toLowerCase().includes(q))
      );

      const featuredSlot = document.getElementById('featured-news-slot');
      const gridSlot = document.getElementById('all-news-grid');

      if (!filtered.length) {
        featuredSlot.innerHTML = '';
        gridSlot.innerHTML = `<div class="col-span-full text-center py-12 text-slate-500 text-sm">Belum ada berita untuk filter atau kata kunci ini.</div>`;
        return;
      }

      const [first, ...rest] = filtered;
      featuredSlot.innerHTML = `
        <article onclick="openNewsDetail('${first.id}')" class="cursor-pointer grid lg:grid-cols-12 rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-md transition">
          <div class="lg:col-span-5 min-h-[220px] bg-gradient-to-br from-ocean-950 to-ocean-900 p-6 flex flex-col justify-between">
            <span class="self-start px-3 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-xs font-bold">${first.kategori} &bull; TERBARU</span>
            <div class="text-sky-200 font-mono text-xs">${formatDateID(first.tanggal)}</div>
          </div>
          <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-center">
            <h2 class="text-xl sm:text-2xl font-bold text-ocean-950 leading-snug">${first.title}</h2>
            <p class="text-slate-600 mt-3 leading-relaxed">${first.ringkasan}</p>
            <div class="pt-5 text-sm font-semibold text-cerulean-600">Baca Artikel Lengkap &rarr;</div>
          </div>
        </article>
      `;
      gridSlot.innerHTML = rest.map(newsCardHTML).join('');
    }

    function openNewsDetail(id) {
      const item = newsData.find(n => n.id === id) || newsData[0];
      document.getElementById('news-detail-content').innerHTML = `
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono mb-4">
          <span class="px-2.5 py-1 rounded-full bg-wijayaCyan-50 text-cerulean-600 font-bold">${item.kategori}</span>
          <span class="text-slate-500">${formatDateID(item.tanggal)}</span>
          <span class="text-slate-400">&bull; Admin SMP Wijaya Sukodono</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-ocean-950 leading-tight">${item.title}</h1>
        <div class="my-6 aspect-video rounded-2xl bg-gradient-to-br from-ocean-950 to-ocean-900 flex flex-col items-center justify-center p-8 text-center text-white">
          <div class="w-16 h-16 mb-3 opacity-80"><svg viewBox="0 0 200 200" class="w-full h-full"><use href="#logo-smp-wijaya"></use></svg></div>
          <div class="text-sm text-sky-100">Slot Foto Sampul Artikel (16:9 via Pages CMS)</div>
        </div>
        <div class="space-y-4 text-base sm:text-[17px] text-slate-700 leading-[1.8]">
          ${item.isi.map(p => `<p>${p}</p>`).join('')}
        </div>
        <div class="mt-8 p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-3">
          <span class="text-sm font-semibold text-ocean-950">Bagikan kabar sekolah ini:</span>
          <div class="flex gap-2">
            <button onclick="showToast('Tautan berita siap dibagikan ke grup WhatsApp.')" class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700">Share WhatsApp</button>
            <button onclick="showToast('Tautan artikel berhasil disalin.')" class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-ocean-950 text-xs font-semibold hover:bg-slate-100">Salin Tautan</button>
          </div>
        </div>
      `;

      const related = newsData.filter(n => n.id !== item.id).slice(0, 2);
      document.getElementById('related-news-grid').innerHTML = related.map(newsCardHTML).join('');
      navigateTo('berita-detail');
    }

    function toggleFaq(btn) {
      const body = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isHidden = body.classList.toggle('hidden');
      icon.textContent = isHidden ? '+' : '−';
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeFacilityModal();
        toggleMobileMenu(false);
      }
    });

    // Initial Render
    renderFacilities();
    renderTeachers();
    renderNewsPage();
    navigateTo('home');
  </script>
</body>
</html>
