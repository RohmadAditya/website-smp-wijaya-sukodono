---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fasilitasJson from '../content/data/fasilitas.json';
import pengaturan from '../content/data/pengaturan.json';
import FacilityModal from '../components/FacilityModal.astro';

const allBerita = await getCollection('berita', ({ data }) => !data.draft);
const sortedBerita = allBerita
  .sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime())
  .slice(0, 3);

const featuredFacilities = (fasilitasJson.daftar || []).slice(0, 6);

function formatDate(date: Date) {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

<BaseLayout
  title="SMP Wijaya Sukodono — Website Resmi Sekolah (NPSN: 20540036)"
  description="Website resmi SMP Wijaya Sukodono, Desa Pekarungan, Kec. Sukodono, Kab. Sidoarjo, Jawa Timur. Informasi profil sekolah, fasilitas, direktori guru, berita prestasi, dan SPMB 2026/2027."
  activeNav="home"
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-ocean-950 via-ocean-900 to-ocean-950 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-wijayaCyan-500/40 bg-ocean-900/60 text-xs font-mono font-semibold text-sky-100">
            <span class="w-2 h-2 rounded-full bg-candiGold-400"></span>
            NPSN {pengaturan.npsn} &bull; {pengaturan.akreditasi.toUpperCase()} &bull; SIDOARJO
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.12]">
            Membangun Generasi <span class="text-candiGold-400">Berilmu, Berkarakter,</span> dan Berprestasi di Sukodono
          </h1>
          <p class="text-base sm:text-lg text-sky-100/90 leading-relaxed max-w-2xl">
            Lebih dari enam dekade mengabdi bagi pendidikan menengah pertama di Desa Pekarungan, Sukodono. SMP Wijaya memadukan pembelajaran akademik terstruktur, disiplin karakter, serta pengembangan bakat olahraga dan seni.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/ppdb"
              class="px-6 py-3.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 font-bold text-sm sm:text-base shadow-md transition inline-block"
            >
              Informasi SPMB 2026/2027
            </a>
            <a
              href="/profil"
              class="px-6 py-3.5 rounded-lg border border-white/30 hover:bg-white/10 text-white font-semibold text-sm sm:text-base transition inline-block"
            >
              Profil &amp; Filosofi Logo
            </a>
          </div>
        </div>

        <!-- Right Hero Signature Experience Card -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-ocean-900/80 border border-white/15 border-t-4 border-t-candiGold-400 p-6 sm:p-8 shadow-2xl backdrop-blur-sm">
            <div class="flex items-start justify-between gap-4 pb-5 border-b border-white/10">
              <div>
                <div class="text-xs font-mono uppercase tracking-wider text-wijayaCyan-400 font-semibold">Rekam Jejak Institusi</div>
                <div class="text-4xl sm:text-5xl font-extrabold text-candiGold-400 mt-1 tracking-tight">6+ Dekade</div>
                <div class="text-sm text-sky-100 mt-1">Purna Widya ke-LXIV &bull; Kelulusan 100%</div>
              </div>
              <div class="w-14 h-14 rounded-xl bg-white/10 p-1.5 flex items-center justify-center shrink-0">
                <svg viewBox="0 0 200 200" class="w-full h-full"><use href="#logo-smp-wijaya"></use></svg>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-3 py-5 border-b border-white/10 text-center">
              <div class="rounded-lg bg-ocean-950/60 p-3">
                <div class="text-xl font-extrabold text-white font-mono">B</div>
                <div class="text-[11px] text-sky-200 mt-0.5">Akreditasi</div>
              </div>
              <div class="rounded-lg bg-ocean-950/60 p-3">
                <div class="text-xl font-extrabold text-white font-mono">100%</div>
                <div class="text-[11px] text-sky-200 mt-0.5">Kelulusan</div>
              </div>
              <div class="rounded-lg bg-ocean-950/60 p-3">
                <div class="text-xl font-extrabold text-white font-mono">8+</div>
                <div class="text-[11px] text-sky-200 mt-0.5">Ekskul Aktif</div>
              </div>
            </div>
            <ul class="pt-5 space-y-2.5 text-sm text-sky-100">
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-candiGold-400"></span>
                Prestasi Drumband &amp; Marching Band Tingkat Kabupaten
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-candiGold-400"></span>
                Pembinaan Olahraga Voli, Pramuka &amp; Paskibra Aktif
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-candiGold-400"></span>
                Lokasi Strategis Desa Pekarungan, Sukodono
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sambutan Kepala Sekolah -->
  <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-4">
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <div class="aspect-[4/5] bg-gradient-to-br from-ocean-950 to-ocean-900 flex flex-col items-center justify-center p-6 text-center relative overflow-hidden">
              {pengaturan.sambutan_kepsek.foto ? (
                <img src={pengaturan.sambutan_kepsek.foto} alt={pengaturan.sambutan_kepsek.nama} class="w-full h-full object-cover" />
              ) : (
                <>
                  <div class="w-28 h-28 rounded-full bg-wijayaCyan-50 border-4 border-candiGold-400 flex items-center justify-center text-ocean-950 text-3xl font-extrabold mb-4 shadow-lg">YF</div>
                  <div class="text-white font-bold text-lg">{pengaturan.sambutan_kepsek.nama}</div>
                  <div class="text-xs font-mono text-wijayaCyan-400 uppercase tracking-wider mt-1">Kepala SMP Wijaya Sukodono</div>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="lg:col-span-8 space-y-5">
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Sambutan Kepala Sekolah</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 tracking-tight">
            Bersama Menyiapkan Generasi Unggul yang Siap Melangkah Lebih Jauh
          </h2>
          {pengaturan.sambutan_kepsek.pesan ? (
            pengaturan.sambutan_kepsek.pesan.split('\n\n').map((p) => (
              <p class="text-slate-600 leading-relaxed">{p}</p>
            ))
          ) : (
            <p class="text-slate-600 leading-relaxed">
              Assalamu'alaikum warahmatullahi wabarakatuh. Puji syukur ke hadirat Allah SWT atas terselenggaranya laman informasi resmi SMP Wijaya Sukodono. Kehadiran website ini menjadi wujud komitmen kami dalam menghadirkan keterbukaan informasi, mendokumentasikan capaian prestasi siswa, serta memudahkan komunikasi antara sekolah, orang tua, alumni, dan masyarakat Sukodono.
            </p>
          )}
          <div class="pt-2 flex flex-wrap items-center gap-6">
            <div>
              <div class="font-bold text-ocean-950">{pengaturan.sambutan_kepsek.nama}</div>
              <div class="text-xs text-slate-500">Kepala Sekolah &bull; SMP Wijaya Sukodono</div>
            </div>
            <a href="/profil" class="text-sm font-semibold text-cerulean-600 hover:text-cerulean-700">
              Baca Profil Lengkap &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 Program Unggulan -->
  <div class="bg-slate-50 py-16 lg:py-24 border-b border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Pilar Pendidikan</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Program Unggulan Sekolah</h2>
        </div>
        <p class="text-sm text-slate-600 max-w-md">Pembinaan terpadu antara kompetensi akademik, pembiasaan karakter religius, dan pengembangan minat bakat siswa.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-cerulean-600/50 hover:shadow-md transition">
          <div class="w-11 h-11 rounded-lg bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center mb-4 font-bold">01</div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">Kurikulum Merdeka &amp; P5</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Pembelajaran kontekstual berpusat pada siswa serta Proyek Penguatan Profil Pelajar Pancasila yang melatih kolaborasi.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-cerulean-600/50 hover:shadow-md transition">
          <div class="w-11 h-11 rounded-lg bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center mb-4 font-bold">02</div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">Drumband &amp; Seni Budaya</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Unit Marching Band aktif berprestasi di tingkat Kabupaten Sidoarjo, melatih disiplin, kekompakan, dan percaya diri.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-cerulean-600/50 hover:shadow-md transition">
          <div class="w-11 h-11 rounded-lg bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center mb-4 font-bold">03</div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">Pembinaan Olahraga</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Klub bola voli dan olahraga prestasi yang aktif menyelenggarakan turnamen antar-SD se-Kecamatan Sukodono.</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-cerulean-600/50 hover:shadow-md transition">
          <div class="w-11 h-11 rounded-lg bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center mb-4 font-bold">04</div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">Karakter &amp; Kepemimpinan</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Pembiasaan ibadah harian, literasi pagi, OSIS, Pramuka, dan Paskibra untuk membentuk pribadi tangguh dan santun.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Pratinjau Fasilitas -->
  <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Sarana Prasarana</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Fasilitas Pendukung Belajar</h2>
        </div>
        <a href="/fasilitas" class="text-sm font-semibold text-cerulean-600 hover:text-cerulean-700">
          Lihat Semua Fasilitas &rarr;
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredFacilities.map((item) => (
          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-cerulean-600/40 transition flex flex-col">
            <div class="aspect-[4/3] bg-gradient-to-br from-ocean-950 to-ocean-900 p-5 flex flex-col justify-between relative overflow-hidden">
              {item.foto && (
                <img src={item.foto} alt={item.nama} class="absolute inset-0 w-full h-full object-cover transition duration-300 hover:scale-105" onerror="this.style.display='none';" />
                <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/30 to-ocean-950/40"></div>
              )}
              <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-sm text-sky-100 font-mono text-[11px] font-semibold">{item.kategori}</span>
              <div class="relative z-10 flex items-center justify-between gap-2">
                <span class="text-white font-bold text-base drop-shadow-md truncate">{item.nama}</span>
                <button
                  type="button"
                  onclick={`openFacilityModal(${JSON.stringify(item)})`}
                  class="px-3 py-1.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 text-xs font-bold transition shrink-0 shadow-md"
                >
                  Lihat Foto
                </button>
              </div>
            </div>
            <div class="p-5 flex-1">
              <h3 class="font-bold text-ocean-950 text-base">{item.nama}</h3>
              <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">{item.deskripsi}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Berita Terbaru (3 Artikel) -->
  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-widest text-cerulean-600">Kabar Sekolah</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ocean-950 mt-1">Berita &amp; Prestasi Terbaru</h2>
        </div>
        <a href="/berita" class="text-sm font-semibold text-cerulean-600 hover:text-cerulean-700">
          Lihat Semua Berita &rarr;
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {sortedBerita.map((item) => (
          <a href={`/berita/${item.id}`} class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md transition flex flex-col group">
            <div class="aspect-video bg-gradient-to-br from-ocean-950 to-ocean-900 p-5 flex flex-col justify-between relative overflow-hidden">
              {item.data.thumbnail ? (
                <img src={item.data.thumbnail} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-105" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center opacity-30">
                  <svg viewBox="0 0 200 200" class="w-16 h-16"><use href="#logo-smp-wijaya"></use></svg>
                </div>
              )}
              <span class="relative z-10 self-start px-2.5 py-1 rounded-full bg-candiGold-400 text-ocean-950 font-mono text-[11px] font-bold shadow-sm">{item.data.kategori}</span>
              <span class="relative z-10 text-sky-200 font-mono text-xs">{formatDate(item.data.tanggal)}</span>
            </div>
            <div class="p-5 flex-1 flex flex-col">
              <h3 class="font-bold text-ocean-950 text-base leading-snug line-clamp-2 group-hover:text-cerulean-600 transition">
                {item.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                {item.data.ringkasan}
              </p>
              <div class="pt-4 text-xs font-semibold text-cerulean-600 mt-auto">
                Baca Selengkapnya &rarr;
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA Strip SPMB -->
  <div class="bg-ocean-950 text-white py-14 border-t-4 border-candiGold-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="text-xs font-mono uppercase tracking-widest text-candiGold-400 font-semibold">SPMB Tahun Ajaran 2026/2027</div>
        <h2 class="text-2xl sm:text-3xl font-bold">Bergabunglah Bersama Keluarga Besar SMP Wijaya Sukodono</h2>
        <p class="text-sm sm:text-base text-sky-100/90">Kunjungi halaman informasi SPMB untuk melihat syarat berkas, jadwal gelombang, atau hubungi langsung panitia Tata Usaha kami.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/ppdb"
          class="px-6 py-3.5 rounded-lg bg-candiGold-400 hover:bg-yellow-300 text-ocean-950 font-bold text-sm transition inline-block shadow-md"
        >
          Buka Info SPMB
        </a>
        <a
          href="/kontak"
          class="px-6 py-3.5 rounded-lg border border-white/30 hover:bg-white/10 text-white font-semibold text-sm transition inline-block"
        >
          Hubungi Tata Usaha
        </a>
      </div>
    </div>
  </div>

  <FacilityModal />
</BaseLayout>
