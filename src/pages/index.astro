---
import { getCollection } from 'astro:content';
import guruJson from '../content/data/guru.json';
import fasilitasJson from '../content/data/fasilitas.json';
import pengaturanJson from '../content/data/pengaturan.json';

const allBerita = await getCollection('berita', ({ data }) => !data.draft);
const sortedBerita = allBerita.sort((a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime());

const newsData = sortedBerita.map((item) => {
  const body = item.body || '';
  const paragraphs = body.split(/\n\n+/).map(p => p.trim()).filter(p => p.length > 0);
  return {
    id: item.id || item.slug,
    title: item.data.title,
    tanggal: item.data.tanggal.toISOString().split('T')[0],
    kategori: item.data.kategori || 'Kegiatan',
    ringkasan: item.data.ringkasan || '',
    gambar: item.data.thumbnail || '',
    isi: paragraphs.length > 0 ? paragraphs : [item.data.ringkasan || '']
  };
});

const teachersData = (typeof window !== 'undefined' && window.cmsTeachersData) ? window.cmsTeachersData : [{"nama": "Yennis Fitriyan, S.E., M.Pd.", "jabatan": "Kepala Sekolah", "bidang": "Pimpinan", "inisial": "YF"}, {"nama": "Wakil Kepala Bidang Kurikulum", "jabatan": "Wakasek Kurikulum", "bidang": "Pimpinan", "inisial": "WK"}, {"nama": "Wakil Kepala Bidang Kesiswaan", "jabatan": "Wakasek Kesiswaan", "bidang": "Pimpinan", "inisial": "KS"}, {"nama": "Guru Bahasa Indonesia", "jabatan": "Mata Pelajaran Bahasa Indonesia", "bidang": "Guru Mapel", "inisial": "BI"}, {"nama": "Guru Matematika", "jabatan": "Mata Pelajaran Matematika", "bidang": "Guru Mapel", "inisial": "MT"}, {"nama": "Guru IPA Terpadu", "jabatan": "Mata Pelajaran IPA", "bidang": "Guru Mapel", "inisial": "IP"}, {"nama": "Pembina Olahraga & Voli", "jabatan": "Guru PJOK & Pembina Ekskul", "bidang": "Guru Mapel", "inisial": "PJ"}, {"nama": "Kepala Tata Usaha", "jabatan": "Layanan Administrasi & SPMB", "bidang": "Staf TU", "inisial": "TU"}, {"nama": "Rohmad Aditya", "jabatan": "TIK", "bidang": "Guru Mapel", "inisial": "PJ"}];
const facilitiesData = (typeof window !== 'undefined' && window.cmsFacilitiesData) ? window.cmsFacilitiesData : [{"id": 1, "nama": "Ruang Kelas Nyaman & Terang", "kategori": "Akademik", "deskripsi": "Ruang kelas kondusif dilengkapi ventilasi udara baik, papan tulis, dan fasilitas pendukung pembelajaran interaktif.", "foto": "/images/uploads/logo-ra.png"}, {"id": 2, "nama": "Laboratorium Komputer & TIK", "kategori": "Laboratorium", "deskripsi": "Sarana praktik literasi digital, simulasi ANBK, dan pembelajaran informatika bagi seluruh siswa."}, {"id": 3, "nama": "Perpustakaan Sekolah", "kategori": "Akademik", "deskripsi": "Koleksi buku pelajaran, referensi bacaan fiksi-nonfiksi, serta sudut literasi pagi siswa SMP Wijaya."}, {"id": 4, "nama": "Laboratorium IPA Terpadu", "kategori": "Laboratorium", "deskripsi": "Mendukung eksperimen fisika, biologi, dan kimia dasar untuk memperdalam pemahaman sains siswa."}, {"id": 5, "nama": "Lapangan Olahraga & Voli", "kategori": "Olahraga & Ibadah", "deskripsi": "Arena latihan rutin ekstrakurikuler bola voli, upacara bendera, serta turnamen pelajar tingkat Kecamatan Sukodono."}, {"id": 6, "nama": "Musholla Sekolah", "kategori": "Olahraga & Ibadah", "deskripsi": "Pusat pembinaan iman dan takwa, sholat dhuha, sholat berjamaah, serta kegiatan keagamaan siswa."}];
const settingsData = pengaturanJson || {};
