---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mengalihkan ke Ekstrakurikuler — SMP Wijaya Sukodono"
  description="Halaman kegiatan ekstrakurikuler resmi SMP Wijaya Sukodono."
  activeNav="ekskul"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="0;url=/ekstrakurikuler" />
    <link rel="canonical" href="https://smpwijayasukodono.sch.id/ekstrakurikuler" />
  </Fragment>

  <div class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-md w-full text-center space-y-5 p-8 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="w-14 h-14 mx-auto rounded-2xl bg-wijayaCyan-50 text-cerulean-600 flex items-center justify-center">
        <svg class="w-7 h-7 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-ocean-950">Mengalihkan ke Halaman Ekstrakurikuler</h1>
        <p class="text-sm text-slate-600 mt-2">
          Halaman kegiatan ekstrakurikuler berada di alamat <strong>/ekstrakurikuler</strong>. Anda sedang dialihkan secara otomatis...
        </p>
      </div>
      <div>
        <a
          href="/ekstrakurikuler"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-cerulean-600 hover:bg-cerulean-700 text-white text-sm font-semibold transition shadow-sm w-full"
        >
          <span>Buka Ekstrakurikuler Sekarang</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    window.location.replace('/ekstrakurikuler');
  </script>
</BaseLayout>
